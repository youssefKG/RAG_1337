digraph RAGDatabase {
    graph [bgcolor="#0f172a", rankdir=LR, splines=ortho, nodesep=0.55, ranksep=0.8, pad=0.35, fontname="Inter,Arial"];
    node [shape=record, style="rounded,filled", fontname="Inter,Arial", fontsize=10, margin="0.12,0.08", color="#475569", fontcolor="#e2e8f0", fillcolor="#1e293b"];
    edge [color="#94a3b8", penwidth=1.5, arrowsize=0.7, fontname="Inter,Arial", fontsize=9, fontcolor="#cbd5e1"];

    file [label="{File|id|path|last_modified_at}", fillcolor="#172554", color="#3b82f6"];
    document [label="{Document|id|content|length|start_index / end_index}", fillcolor="#1e3a8a", color="#60a5fa"];
    term [label="{Term|value|frequency|document_id}", fillcolor="#164e63", color="#22d3ee"];
    question [label="{Question|id|question|top_k|search_type}", fillcolor="#4c1d95", color="#a78bfa"];
    qdoc [label="{QuestionDocument|question_id|document_id}", fillcolor="#581c87", color="#c084fc"];
    answer [label="{QuestionAnswer|question_id|answer}", fillcolor="#701a75", color="#e879f9"];
    sqlite [label="{SQLite database|src/db.sqlite3|files, chunks, terms, questions, answers}", shape=cylinder, fillcolor="#422006", color="#f59e0b"];
    vector [label="{ChromaDB collection|document|chunk + embedding + metadata}", shape=cylinder, fillcolor="#500724", color="#f472b6"];

    file -> document [label=" contains 1..*"];
    document -> term [label=" indexed by 1..*"];
    question -> qdoc [label=" retrieves 1..*"];
    qdoc -> document [label=" selects 1"];
    question -> answer [label=" has 0..1"];
    sqlite -> file [label=" persists"];
    sqlite -> document [label=" persists"];
    sqlite -> term [label=" persists"];
    sqlite -> question [label=" persists"];
    sqlite -> qdoc [label=" persists"];
    sqlite -> answer [label=" persists"];
    vector -> document [label=" stores vector copy"];
}
