digraph RAGSequence {
    graph [bgcolor="#0f172a", rankdir=LR, splines=ortho, nodesep=0.45, ranksep=0.55, pad=0.35, fontname="Inter,Arial"];
    node [shape=box, style="rounded,filled", fontname="Inter,Arial", fontsize=11, margin="0.16,0.10", color="#475569", fontcolor="#e2e8f0", fillcolor="#1e293b"];
    edge [color="#94a3b8", penwidth=1.5, arrowsize=0.7, fontname="Inter,Arial", fontsize=9, fontcolor="#cbd5e1"];

    user [label="User", fillcolor="#172554", color="#60a5fa"];
    cli [label="CLI", fillcolor="#312e81", color="#818cf8"];
    app [label="RageAgainstMachine", fillcolor="#4c1d95", color="#a78bfa"];
    answer [label="AnswerManager", fillcolor="#581c87", color="#c084fc"];
    cache [label="SQLite cache", shape=cylinder, fillcolor="#422006", color="#f59e0b"];
    search [label="SearchEngine", fillcolor="#7c2d12", color="#fb923c"];
    bm25 [label="BM25", fillcolor="#9a3412", color="#fdba74"];
    chroma [label="ChromaDB\nhybrid only", shape=cylinder, fillcolor="#500724", color="#f472b6"];
    model [label="Qwen3 model", fillcolor="#701a75", color="#e879f9"];

    user -> cli [label=" answer(query, k, hybrid)"];
    cli -> app [label=" validate"];
    app -> answer [label=" answer"];
    answer -> cache [label=" lookup"];
    cache -> answer [label=" hit / miss"];
    answer -> search [label=" cache miss"];
    search -> cache [label=" cache sources"];
    search -> bm25 [label=" lexical ranking"];
    bm25 -> search [label=" top chunks"];
    search -> chroma [label=" vector search"];
    chroma -> search [label=" semantic chunks"];
    search -> answer [label=" context"];
    answer -> model [label=" grounded prompt"];
    model -> answer [label=" generated answer"];
    answer -> cache [label=" cache answer"];
    answer -> user [label=" response"];
}
